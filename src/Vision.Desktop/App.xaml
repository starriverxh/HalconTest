<Application x:Class="Vision.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBackground" Color="#111C2E" />
        <SolidColorBrush x:Key="PanelBorder" Color="#26354D" />
        <SolidColorBrush x:Key="Primary" Color="#38BDF8" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E7EEF8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#92A4BC" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1424" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,5,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C2A40" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
