<Window x:Class="Vision.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vision.Desktop.Controls"
        Title="HALCON 钢针插装视觉开发工作站"
        Width="1540"
        Height="940"
        MinWidth="1220"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="HALCON 钢针插装视觉开发工作站" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           Text="C# + HalconDotNet · ROI · Blob预处理 · Shape Model · 九点示教标定 · 生产检测" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar Width="110" Height="3" Margin="0,0,14,0" IsIndeterminate="{Binding IsBusy}" />
                <Border Padding="14,8"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding StatusBrush}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ConnectionStatus}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="服务与图像" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,5,8,10" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Button Command="{Binding PingCommand}" Content="测试 Socket 连接" />
                        <TextBox MinHeight="54"
                                 Text="{Binding SelectedImagePath, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <Button Command="{Binding SelectImageCommand}" Content="选择离线产品图片…" />
                    </StackPanel>
                    <Separator Grid.Row="1" Margin="0,14" Background="{StaticResource PanelBorder}" />
                    <Border Grid.Row="2" Padding="10" Background="#0B1424" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="#38BDF8" Text="操作顺序：" />
                            <LineBreak />
                            <Run Text="1 选图 → 2 ROI/预处理 → 3 模板 → 4 九点示教 → 5 固化配方 → 6 运行检测。工程调试功能通过 Socket 调用服务端 HALCON 算子。" />
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="运行日志" />
                        <ListBox Margin="0,10,0,0"
                                 Background="#0B1424"
                                 BorderBrush="{StaticResource PanelBorder}"
                                 Foreground="{StaticResource TextSecondary}"
                                 ItemsSource="{Binding Logs}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="4" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Column="2">
                <TabItem Header="1 运行检测">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="185" />
                        </Grid.RowDefinitions>
                        <Border Background="#050A12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <controls:VisionImageViewer Source="{Binding PreviewImage}" />
                        </Border>
                        <Border Grid.Row="2" Padding="18" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding TriggerCommand}" Content="触发生产检测" />
                                    <Border Margin="0,10,0,0" Padding="12" BorderBrush="{Binding StatusBrush}" BorderThickness="2" CornerRadius="6">
                                        <TextBlock HorizontalAlignment="Center" Foreground="{Binding StatusBrush}" FontSize="34" FontWeight="Bold" Text="{Binding InspectionStatus}" />
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Foreground="{StaticResource TextSecondary}" Text="X补偿" /><TextBlock Margin="0,8,0,0" FontSize="21" Text="{Binding CorrectionX}" /></StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Foreground="{StaticResource TextSecondary}" Text="Y补偿" /><TextBlock Margin="0,8,0,0" FontSize="21" Text="{Binding CorrectionY}" /></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Foreground="{StaticResource TextSecondary}" Text="T补偿" /><TextBlock Margin="0,8,0,0" FontSize="21" Text="{Binding CorrectionTheta}" /></StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Foreground="{StaticResource TextSecondary}" Text="分数" /><TextBlock Margin="0,8,0,0" FontSize="21" Text="{Binding Score}" /></StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Foreground="{StaticResource TextSecondary}" Text="耗时" /><TextBlock Margin="0,8,0,0" FontSize="21" Text="{Binding Duration}" /></StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="2 ROI / 图像处理">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="15" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Blob 参数" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#38BDF8" Text="鼠标左键拖动：绘制 Rectangle1 ROI" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}">
                                        <Run Text="R1=" /><Run Text="{Binding CurrentRoi.Row1, StringFormat=F1}" />
                                        <Run Text="  C1=" /><Run Text="{Binding CurrentRoi.Column1, StringFormat=F1}" />
                                        <LineBreak />
                                        <Run Text="R2=" /><Run Text="{Binding CurrentRoi.Row2, StringFormat=F1}" />
                                        <Run Text="  C2=" /><Run Text="{Binding CurrentRoi.Column2, StringFormat=F1}" />
                                    </TextBlock>
                                    <Button Command="{Binding ClearRoiCommand}" Content="清除 ROI（处理整图）" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="灰度阈值下限" /><TextBox Text="{Binding ThresholdMin, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="灰度阈值上限" /><TextBox Text="{Binding ThresholdMax, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="最小半径 px" /><TextBox Text="{Binding MinRadiusPx, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="最大半径 px" /><TextBox Text="{Binding MaxRadiusPx, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="最小圆度 0~1" /><TextBox Text="{Binding MinCircularity, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding PreviewProcessingCommand}" Content="执行 HALCON 预处理" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Margin="0,4,3,4" Command="{Binding ShowProcessingOriginalCommand}" Content="原图+结果" />
                                        <Button Grid.Column="1" Margin="3,4,0,4" Command="{Binding ShowProcessingBinaryCommand}" Content="二值结果" />
                                    </Grid>
                                    <Border Margin="0,10,0,0" Padding="10" Background="#0B1424" CornerRadius="6">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding ProcessingSummary}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="2" Background="#050A12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <controls:VisionImageViewer Source="{Binding ProcessingPreviewImage}"
                                                        Roi="{Binding CurrentRoi, Mode=TwoWay}"
                                                        Overlays="{Binding ProcessingOverlays}"
                                                        IsRoiDrawingEnabled="True" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="3 模板匹配">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="15" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="HALCON Shape Model" />
                                    <TextBlock Margin="0,8,0,5" Foreground="#38BDF8" Text="在右侧拖 ROI，框住具有唯一轮廓的产品特征。" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="模型名称" /><TextBox Text="{Binding ModelName}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="角度起点 °" /><TextBox Text="{Binding ModelAngleStartDeg}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="角度范围 °" /><TextBox Text="{Binding ModelAngleExtentDeg}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Contrast" /><TextBox Text="{Binding ModelContrast}" />
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateTemplateCommand}" Content="1. create_shape_model + 保存" />
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" Text="模型 .shm 路径" />
                                    <TextBox MinHeight="48" Text="{Binding ShapeModelPath}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="最小匹配分数" /><TextBox Text="{Binding MatchMinScore}" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="返回数量（0=全部）" /><TextBox Text="{Binding MatchCount}" />
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding MatchTemplateCommand}" Content="2. find_shape_model 匹配" />
                                    <Border Margin="0,10,0,0" Padding="10" Background="#0B1424" CornerRadius="6"><TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding TemplateSummary}" TextWrapping="Wrap" /></Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="2" Background="#050A12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <controls:VisionImageViewer Source="{Binding PreviewImage}"
                                                        Roi="{Binding CurrentRoi, Mode=TwoWay}"
                                                        Overlays="{Binding TemplateOverlays}"
                                                        IsRoiDrawingEnabled="True" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="4 九点标定示教">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="270" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="15" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="单点示教" />
                                        <TextBlock Margin="0,8,0,5" Foreground="#F59E0B" Text="右侧单击特征中心 → 移动平台并读取机械坐标 → 输入 X/Y → 加入。" TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,0"><TextBlock Foreground="{StaticResource TextSecondary}" Text="图像 Row" /><TextBox IsReadOnly="True" Text="{Binding TeachingRow, StringFormat=F2}" /></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Foreground="{StaticResource TextSecondary}" Text="图像 Column" /><TextBox IsReadOnly="True" Text="{Binding TeachingColumn, StringFormat=F2}" /></StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,0"><TextBlock Foreground="{StaticResource TextSecondary}" Text="机械 X mm" /><TextBox Text="{Binding TeachingMachineX, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Foreground="{StaticResource TextSecondary}" Text="机械 Y mm" /><TextBox Text="{Binding TeachingMachineY, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        </Grid>
                                        <CheckBox Margin="0,3,0,8" IsChecked="{Binding TeachingUseForFit}" Content="用于拟合（不勾选=独立验证点）" />
                                        <Button Command="{Binding SnapCalibrationPointCommand}" Content="HALCON 精定位最近圆心" />
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCalibrationPointCommand}" Content="加入示教点" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button Margin="0,4,3,4" Command="{Binding LoadCalibrationCsvCommand}" Content="载入示例 CSV" />
                                            <Button Grid.Column="1" Margin="3,4,0,4" Command="{Binding RemoveCalibrationPointCommand}" Content="删除选中点" />
                                        </Grid>
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="模型输出" /><TextBox MinHeight="43" Text="{Binding CalibrationModelPath}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="点位 CSV 输出" /><TextBox MinHeight="43" Text="{Binding CalibrationCsvPath}" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding FitCalibrationCommand}" Content="vector_to_hom_mat2d 拟合并保存" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="2" Background="#050A12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <controls:VisionImageViewer Source="{Binding PreviewImage}"
                                                            SelectedPoint="{Binding SelectedCalibrationImagePoint, Mode=TwoWay}"
                                                            Overlays="{Binding CalibrationOverlays}" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Padding="12" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Margin="2,0,2,8" Foreground="{StaticResource TextSecondary}" Text="{Binding CalibrationSummary}" TextWrapping="Wrap" />
                                <DataGrid Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          ItemsSource="{Binding CalibrationPoints}"
                                          SelectedItem="{Binding SelectedCalibrationPoint}"
                                          Background="#0B1424"
                                          Foreground="#E7EEF8"
                                          BorderBrush="{StaticResource PanelBorder}"
                                          RowBackground="#0B1424"
                                          AlternationCount="100"
                                          AlternatingRowBackground="#111C2E">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex}" IsReadOnly="True" Width="42" />
                                        <DataGridTextColumn Header="Row" Binding="{Binding Row, StringFormat=F3}" Width="85" />
                                        <DataGridTextColumn Header="Column" Binding="{Binding Column, StringFormat=F3}" Width="85" />
                                        <DataGridTextColumn Header="Machine X" Binding="{Binding MachineX, StringFormat=F4}" Width="95" />
                                        <DataGridTextColumn Header="Machine Y" Binding="{Binding MachineY, StringFormat=F4}" Width="95" />
                                        <DataGridCheckBoxColumn Header="拟合" Binding="{Binding UseForFit}" Width="55" />
                                        <DataGridTextColumn Header="预测 X" Binding="{Binding PredictedX, StringFormat=F5}" IsReadOnly="True" Width="90" />
                                        <DataGridTextColumn Header="预测 Y" Binding="{Binding PredictedY, StringFormat=F5}" IsReadOnly="True" Width="90" />
                                        <DataGridTextColumn Header="误差 mm" Binding="{Binding ErrorMm, StringFormat=F6}" IsReadOnly="True" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
