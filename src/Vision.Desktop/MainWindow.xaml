<Window x:Class="Vision.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HALCON 钢针插装视觉工作站"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="HALCON 钢针插装视觉工作站" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           Text="C# + HalconDotNet · 离线图像 · 九点标定 · PCB孔定位 · XYT补偿" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="16,9"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,9,0" Fill="{Binding StatusBrush}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ConnectionStatus}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="服务连接" />
                        <TextBlock Margin="0,14,0,0" Foreground="{StaticResource TextSecondary}" Text="主机" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="端口" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Command="{Binding PingCommand}" Content="测试连接" />
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,18" Background="{StaticResource PanelBorder}" />

                    <StackPanel Grid.Row="2">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="离线图像" />
                        <TextBox MinHeight="58"
                                 Text="{Binding SelectedImagePath, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <Button Command="{Binding SelectImageCommand}" Content="选择图片…" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding TriggerCommand}"
                                Content="触发视觉检测" />
                        <ProgressBar Height="3"
                                     Margin="0,10,0,0"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Separator Grid.Row="3" Margin="0,18" Background="{StaticResource PanelBorder}" />

                    <StackPanel Grid.Row="4">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="运行日志" />
                        <ListBox Margin="0,12,0,0"
                                 Background="#0B1424"
                                 BorderBrush="{StaticResource PanelBorder}"
                                 Foreground="{StaticResource TextSecondary}"
                                 ItemsSource="{Binding Logs}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="5" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="210" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#050A12"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Grid>
                        <Image Margin="12" Source="{Binding PreviewImage}" Stretch="Uniform" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#50627A"
                                   FontSize="18"
                                   Text="选择图片或触发检测后显示图像">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="20"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,20,0"
                                Background="#0B1424"
                                BorderBrush="{Binding StatusBrush}"
                                BorderThickness="2"
                                CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="检测结果" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{Binding StatusBrush}"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Text="{Binding InspectionStatus}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="X补偿" />
                                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding CorrectionX}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Y补偿" />
                                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding CorrectionY}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="T补偿" />
                                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding CorrectionTheta}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="特征分数" />
                                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding Score}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="耗时" />
                                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding Duration}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
