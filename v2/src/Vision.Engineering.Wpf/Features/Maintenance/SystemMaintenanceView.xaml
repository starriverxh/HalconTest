<UserControl x:Class="VisionSystem.Engineering.Wpf.Features.Maintenance.SystemMaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="220" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8"><TextBlock FontSize="16" FontWeight="SemiBold" Text="设备与Runtime健康" /><Button HorizontalAlignment="Right" Margin="0" Style="{StaticResource PrimaryButton}" Command="{Binding RunHealthCheckCommand}" Content="运行健康检查" /></Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Margin="4" Padding="10" Background="#081421" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Margin="0,4,0,0" Foreground="#FBBF24" Text="{Binding State}" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Detail}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8"><TextBlock FontSize="16" FontWeight="SemiBold" Text="活动报警" /><Button HorizontalAlignment="Right" Margin="0" Command="{Binding AcknowledgeAlarmCommand}" Content="确认选中报警" /></Grid>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Alarms}" SelectedItem="{Binding SelectedAlarm}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="80" />
                            <DataGridTextColumn Header="错误码" Binding="{Binding Code}" Width="220" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="130" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100" />
                            <DataGridTextColumn Header="恢复步骤" Binding="{Binding Recovery}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10"><StackPanel><TextBlock FontWeight="SemiBold" Text="处理结果" /><TextBlock Margin="0,8,0,0" Foreground="#FDE68A" Text="{Binding MaintenanceMessage}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock FontWeight="SemiBold" Text="最近审计事件" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AuditEvents}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
