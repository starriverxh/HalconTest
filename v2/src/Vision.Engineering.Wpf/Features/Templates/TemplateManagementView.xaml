<UserControl x:Class="VisionSystem.Engineering.Wpf.Features.Templates.TemplateManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="模型草稿参数" />
                <Border Margin="0,8,0,10" Padding="9" Background="#3B1F08" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5"><TextBlock Foreground="#FDE68A" Text="教学模拟：不调用Runtime，不执行create_shape_model，不生成或写入.shm；关闭WPF后数据丢失。" TextWrapping="Wrap" /></Border>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="模型名称" /><TextBox Text="{Binding ModelName}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="角度起点 [deg]" /><TextBox Text="{Binding AngleStartDeg}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="角度范围 [deg]" /><TextBox Text="{Binding AngleExtentDeg}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Contrast [gray]" /><TextBox Text="{Binding Contrast}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Minimum score [0…1]" /><TextBox Text="{Binding MinimumScore}" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateDraftModelCommand}" Content="1 生成教学轮廓（内存）" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ValidateTemplateCommand}" Content="2 运行教学验证数据" />
                <Border Margin="0,10,0,0" Padding="10" Background="#0B2630" CornerRadius="5"><StackPanel><TextBlock Foreground="#5EEAD4" Text="模板状态" /><TextBlock Margin="0,4,0,0" FontFamily="Consolas" Text="{Binding ModelVersion}" /></StackPanel></Border>
            </StackPanel></ScrollViewer>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,10,0" Padding="0" ClipToBounds="True">
            <Grid Background="#04101B">
                <Canvas>
                    <Rectangle Canvas.Left="75" Canvas.Top="80" Width="650" Height="370" Fill="#164C35" Stroke="#4ADE80" StrokeThickness="2" />
                    <Rectangle Canvas.Left="120" Canvas.Top="175" Width="560" Height="170" Fill="#18324C" Stroke="#38BDF8" StrokeThickness="2" StrokeDashArray="5 3" />
                    <Line X1="150" Y1="200" X2="650" Y2="200" Stroke="#F97316" StrokeThickness="3" />
                    <Line X1="150" Y1="320" X2="650" Y2="320" Stroke="#F97316" StrokeThickness="3" />
                    <Ellipse Canvas.Left="185" Canvas.Top="235" Width="42" Height="42" Stroke="#FDE047" StrokeThickness="3" />
                    <Ellipse Canvas.Left="285" Canvas.Top="235" Width="42" Height="42" Stroke="#FDE047" StrokeThickness="3" />
                    <Ellipse Canvas.Left="385" Canvas.Top="235" Width="42" Height="42" Stroke="#FDE047" StrokeThickness="3" />
                    <Ellipse Canvas.Left="485" Canvas.Top="235" Width="42" Height="42" Stroke="#FDE047" StrokeThickness="3" />
                    <Ellipse Canvas.Left="585" Canvas.Top="235" Width="42" Height="42" Stroke="#FDE047" StrokeThickness="3" />
                    <Line X1="400" Y1="235" X2="400" Y2="285" Stroke="#2DD4BF" StrokeThickness="2" />
                    <Line X1="375" Y1="260" X2="425" Y2="260" Stroke="#2DD4BF" StrokeThickness="2" />
                    <TextBlock Canvas.Left="130" Canvas.Top="145" Foreground="#7DD3FC" Text="Template ROI（唯一轮廓组合）" />
                    <TextBlock Canvas.Left="430" Canvas.Top="270" Foreground="#5EEAD4" Text="Model origin" />
                </Canvas>
                <Border VerticalAlignment="Bottom" Padding="12" Background="#D0081421"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="蓝框=训练ROI · 黄线=模型XLD轮廓 · 青色十字=模型原点（教学绘制）" /></Border>
            </Grid>
        </Border>
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10"><StackPanel><TextBlock FontWeight="SemiBold" Text="训练/验证样本" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Samples}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,3" Padding="8" Background="#081421" CornerRadius="4"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10"><StackPanel><TextBlock FontWeight="SemiBold" Text="金字塔中间轮廓" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ContourLayers}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3" FontFamily="Consolas" Foreground="#7DD3FC" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock FontWeight="SemiBold" Text="验证摘要" /><TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ValidationSummary}" TextWrapping="Wrap" /></StackPanel></Border>
        </StackPanel>
    </Grid>
</UserControl>
