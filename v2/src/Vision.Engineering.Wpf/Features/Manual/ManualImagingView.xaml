<UserControl x:Class="VisionSystem.Engineering.Wpf.Features.Manual.ManualImagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="相机与光源参数（草稿）" />
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="触发模式" />
                <ComboBox ItemsSource="{Binding TriggerModes}" SelectedItem="{Binding SelectedTriggerMode}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="曝光 Exposure [µs]" />
                <TextBox Text="{Binding ExposureMicroseconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="增益 Gain [dB]" />
                <TextBox Text="{Binding GainDb, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="光源 CH1 [%]" />
                <TextBox Text="{Binding LightPercent, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="触发延迟 [µs]" />
                <TextBox Text="{Binding TriggerDelayMicroseconds, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AcquireSingleFrameCommand}" Content="采集单帧（合成）" />
                <Button Style="{StaticResource DangerButton}" Command="{Binding AttemptMotionCommand}" Content="请求轴点动（将被拒绝）" />
                <Border Margin="0,10,0,0" Padding="10" Background="#301515" CornerRadius="5"><TextBlock Foreground="#FCA5A5" Text="{Binding MotionMessage}" TextWrapping="Wrap" /></Border>
            </StackPanel></ScrollViewer>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,10,0" Padding="0" ClipToBounds="True">
            <Grid Background="#04101B">
                <Canvas>
                    <Rectangle Canvas.Left="90" Canvas.Top="90" Width="650" Height="360" Fill="#164C35" Stroke="#4ADE80" StrokeThickness="2" RadiusX="12" RadiusY="12" />
                    <TextBlock Canvas.Left="115" Canvas.Top="115" FontSize="18" Foreground="#A7F3D0" Text="OFFLINE SYNTHETIC FRAME" />
                    <Line X1="160" Y1="245" X2="690" Y2="245" Stroke="#FB923C" StrokeThickness="3" />
                    <Line X1="160" Y1="330" X2="690" Y2="330" Stroke="#FB923C" StrokeThickness="3" />
                </Canvas>
                <Border VerticalAlignment="Bottom" Padding="12" Background="#D0081421"><Grid><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding CameraState}" /><TextBlock HorizontalAlignment="Right" FontFamily="Consolas" Foreground="#7DD3FC" Text="{Binding FrameId}" /></Grid></Border>
            </Grid>
        </Border>
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                <StackPanel><TextBlock FontWeight="SemiBold" Text="图像质量中间结果" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding QualityMetrics}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,3" Padding="9" Background="#081421" CornerRadius="5"><TextBlock FontFamily="Consolas" Foreground="#A7F3D0" Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock FontWeight="SemiBold" Text="接入真实硬件后" /><TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="1. 枚举并锁定序列号&#x0a;2. 完成硬触发/频闪时序&#x0a;3. 30次重复采图统计&#x0a;4. 中心/四角分辨率检查&#x0a;5. 参数写入草稿配方" TextWrapping="Wrap" /></StackPanel></Border>
        </StackPanel>
    </Grid>
</UserControl>
