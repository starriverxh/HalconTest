<UserControl x:Class="VisionSystem.Engineering.Wpf.Features.Calibration.CalibrationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="190" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock FontWeight="SemiBold" Text="标定类型" /><ComboBox ItemsSource="{Binding CalibrationKinds}" SelectedItem="{Binding SelectedCalibrationKind}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="硬件指纹" /><TextBlock Margin="0,5,0,0" FontFamily="Consolas" Foreground="#FBBF24" Text="{Binding HardwareFingerprint}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0"><TextBlock FontWeight="SemiBold" Text="拟合/验证结论" /><Border Margin="0,6,0,6" Padding="8" Background="#3B1F08" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5"><TextBlock Foreground="#FDE68A" Text="教学数据：不读取PLC/相机，不写标定JSON，不替换Runtime标定。" TextWrapping="Wrap" /></Border><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding FitSummary}" TextWrapping="Wrap" /><TextBlock Margin="0,5,0,0" Foreground="#A7F3D0" Text="{Binding CalibrationVersion}" /></StackPanel>
                <StackPanel Grid.Column="2"><Button Style="{StaticResource PrimaryButton}" Command="{Binding FitOfflinePointsCommand}" Content="九点教学拟合（内存）" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding RunTAxisTeachingCommand}" Content="T轴中心教学拟合" /><Button Style="{StaticResource DangerButton}" Command="{Binding AttemptAutomaticTeachCommand}" Content="自动走点（将被拒绝）" /></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="拟合点与独立验证点残差" />
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Points}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                            <DataGridTextColumn Header="Row [px]" Binding="{Binding Row, StringFormat=F2}" Width="85" />
                            <DataGridTextColumn Header="Column [px]" Binding="{Binding Column, StringFormat=F2}" Width="95" />
                            <DataGridTextColumn Header="Machine X [mm]" Binding="{Binding MachineX, StringFormat=F4}" Width="115" />
                            <DataGridTextColumn Header="Machine Y [mm]" Binding="{Binding MachineY, StringFormat=F4}" Width="115" />
                            <DataGridTextColumn Header="Error [mm]" Binding="{Binding ErrorMm, StringFormat=F4}" Width="95" />
                            <DataGridCheckBoxColumn Header="Validation" Binding="{Binding IsValidation}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="标定向导检查点" />
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" Text="① 固定焦距/光圈/工作距离/光源&#x0a;② 先做相机内参与畸变&#x0a;③ PLC同步走点并读取X/Y&#x0a;④ HALCON自动精定位，不用鼠标点作为精度点&#x0a;⑤ 九点覆盖视野四角、边中和中心&#x0a;⑥ 独立点不参与拟合&#x0a;⑦ 查看残差矢量和热图&#x0a;⑧ 随机位置复测&#x0a;⑨ 绑定硬件指纹和有效期&#x0a;⑩ 质量角色审批" TextWrapping="Wrap" />
                    <Border Margin="0,14,0,0" Padding="10" Background="#301515" CornerRadius="5"><TextBlock Foreground="#FCA5A5" Text="当前阻断：相机/PLC未接入，不能证明0.05 mm。" TextWrapping="Wrap" /></Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
