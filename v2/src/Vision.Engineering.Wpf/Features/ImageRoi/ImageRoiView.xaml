<UserControl x:Class="VisionSystem.Engineering.Wpf.Features.ImageRoi.ImageRoiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VisionSystem.Engineering.Wpf.Controls">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="生产算法节点" /><TextBlock Margin="0,5,0,10" Foreground="{StaticResource MutedTextBrush}" Text="选中节点查看算子、输出和状态。" TextWrapping="Wrap" /></StackPanel>
                <ListBox Grid.Row="1" Background="#081421" BorderThickness="0" ItemsSource="{Binding PipelineStages}" SelectedItem="{Binding SelectedPipelineStage}">
                    <ListBox.ItemTemplate><DataTemplate><Border Margin="2" Padding="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" Foreground="#7DD3FC" Text="{Binding OperatorChain}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" Foreground="#A7F3D0" Text="{Binding Status}" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2"><Button Style="{StaticResource PrimaryButton}" Command="{Binding RunPipelinePreviewCommand}" Content="逐节点运行离线预览" /><TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding PreviewSummary}" TextWrapping="Wrap" /></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="0,0,10,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal"><TextBlock Margin="5,0,10,0" VerticalAlignment="Center" Text="ROI工具" /><ComboBox Width="150" Margin="0" ItemsSource="{Binding ShapeKinds}" SelectedItem="{Binding ActiveTool}" /><TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Rectangle1/2拖动 · Circle从圆心拖动 · Polygon左键加点/右键结束" /></StackPanel>
            </Border>
            <Border Grid.Row="1" Margin="0,0,0,8" Padding="9,6" Background="#3B1F08" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5"><TextBlock Foreground="#FDE68A" Text="教学内存草稿：画布不读取真实相机/Runtime图像，不写配方JSON；关闭WPF后本页修改丢失。" TextWrapping="Wrap" /></Border>
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="0" ClipToBounds="True">
                <controls:RoiCanvas ItemsSource="{Binding Rois}" SelectedRoi="{Binding SelectedRoi, Mode=TwoWay}" ActiveTool="{Binding ActiveTool}" RoiCreatedCommand="{Binding AddRoiCommand}" />
            </Border>
        </Grid>
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="190" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding Rois}" SelectedItem="{Binding SelectedRoi}" DisplayMemberPath="Name" Background="#081421" BorderBrush="{StaticResource BorderBrush}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0" DataContext="{Binding SelectedRoi}">
                    <TextBlock FontWeight="SemiBold" Text="选中ROI属性" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="名称" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="形状" /><TextBox IsReadOnly="True" Text="{Binding ShapeKind}" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="坐标空间" /><ComboBox ItemsSource="{Binding DataContext.CoordinateSpaces, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding CoordinateSpace}" />
                    <CheckBox Margin="0,4,0,10" IsChecked="{Binding FollowLocalization}" Content="跟随粗定位位姿" />
                    <TextBlock FontWeight="SemiBold" Foreground="#7DD3FC" Text="Rectangle1 [px]" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Row1 / Row2" /><TextBox Text="{Binding Row1}" /><TextBox Text="{Binding Row2}" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Column1 / Column2" /><TextBox Text="{Binding Column1}" /><TextBox Text="{Binding Column2}" /></StackPanel></Grid>
                    <TextBlock FontWeight="SemiBold" Foreground="#7DD3FC" Text="Rectangle2 / Circle [px]" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Center Row" /><TextBox Text="{Binding CenterRow}" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Center Column" /><TextBox Text="{Binding CenterColumn}" /></StackPanel></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Length1 / Length2" /><TextBox Text="{Binding Length1}" /><TextBox Text="{Binding Length2}" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Phi [deg] / Radius" /><TextBox Text="{Binding PhiDeg}" /><TextBox Text="{Binding Radius}" /></StackPanel></Grid>
                </StackPanel></ScrollViewer>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Margin="0,4,3,0" Command="{Binding DuplicateRoiCommand}" Content="复制" /><Button Grid.Column="1" Margin="3,4,0,0" Style="{StaticResource DangerButton}" Command="{Binding DeleteRoiCommand}" Content="删除草稿ROI" /></Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
