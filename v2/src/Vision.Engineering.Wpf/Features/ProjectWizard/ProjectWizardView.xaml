<UserControl x:Class="VisionSystem.Engineering.Wpf.Features.ProjectWizard.ProjectWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="工业视觉开发Gate" /><TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedTextBrush}" Text="按证据推进，不按“代码写了多少”推进。红色阻断项不会被合成图自动变绿。" /></StackPanel>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Gates}" SelectedItem="{Binding SelectedGate}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Gate" Binding="{Binding Number}" Width="55" />
                        <DataGridTextColumn Header="阶段" Binding="{Binding Name}" Width="170" />
                        <DataGridTextColumn Header="必须留下的证据" Binding="{Binding Evidence}" Width="*" />
                        <DataGridTextColumn Header="验收定义" Binding="{Binding Acceptance}" Width="*" />
                        <DataGridTextColumn Header="当前状态" Binding="{Binding Status}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                <StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="选中Gate" /><TextBlock Margin="0,12,0,0" MinHeight="150" Foreground="{StaticResource MutedTextBrush}" Text="{Binding GateDetail}" TextWrapping="Wrap" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding ReviewSelectedGateCommand}" Content="复核证据完整性" /></StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel><TextBlock FontWeight="SemiBold" Text="推荐学习顺序" /><TextBlock Margin="0,8,0,0" Foreground="#A7F3D0" Text="需求/误差预算&#x0a;↓&#x0a;相机镜头光源&#x0a;↓&#x0a;样本/算法/ROI/模板&#x0a;↓&#x0a;标定与闭环&#x0a;↓&#x0a;数据集回归&#x0a;↓&#x0a;审批/生产/追溯" TextWrapping="Wrap" /></StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
