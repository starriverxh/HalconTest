<Window x:Class="VisionSystem.Engineering.Wpf.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionSystem.Engineering.Wpf.Controls"
        xmlns:production="clr-namespace:VisionSystem.Engineering.Wpf.Features.Production"
        xmlns:manual="clr-namespace:VisionSystem.Engineering.Wpf.Features.Manual"
        xmlns:wizard="clr-namespace:VisionSystem.Engineering.Wpf.Features.ProjectWizard"
        xmlns:roi="clr-namespace:VisionSystem.Engineering.Wpf.Features.ImageRoi"
        xmlns:templates="clr-namespace:VisionSystem.Engineering.Wpf.Features.Templates"
        xmlns:calibration="clr-namespace:VisionSystem.Engineering.Wpf.Features.Calibration"
        xmlns:recipes="clr-namespace:VisionSystem.Engineering.Wpf.Features.Recipes"
        xmlns:regression="clr-namespace:VisionSystem.Engineering.Wpf.Features.Regression"
        xmlns:trace="clr-namespace:VisionSystem.Engineering.Wpf.Features.Traceability"
        xmlns:maintenance="clr-namespace:VisionSystem.Engineering.Wpf.Features.Maintenance"
        Title="Vision Engineering Workstation V2"
        Width="1680" Height="980" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type production:ProductionViewModel}"><production:ProductionView /></DataTemplate>
        <DataTemplate DataType="{x:Type manual:ManualImagingViewModel}"><manual:ManualImagingView /></DataTemplate>
        <DataTemplate DataType="{x:Type wizard:ProjectWizardViewModel}"><wizard:ProjectWizardView /></DataTemplate>
        <DataTemplate DataType="{x:Type roi:ImageRoiViewModel}"><roi:ImageRoiView /></DataTemplate>
        <DataTemplate DataType="{x:Type templates:TemplateManagementViewModel}"><templates:TemplateManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type calibration:CalibrationCenterViewModel}"><calibration:CalibrationCenterView /></DataTemplate>
        <DataTemplate DataType="{x:Type recipes:RecipeCenterViewModel}"><recipes:RecipeCenterView /></DataTemplate>
        <DataTemplate DataType="{x:Type regression:DatasetRegressionViewModel}"><regression:DatasetRegressionView /></DataTemplate>
        <DataTemplate DataType="{x:Type trace:TraceabilityViewModel}"><trace:TraceabilityView /></DataTemplate>
        <DataTemplate DataType="{x:Type maintenance:SystemMaintenanceViewModel}"><maintenance:SystemMaintenanceView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0D1B2E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="Bold" Text="VISION ENGINEERING V2" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="C# WPF · HALCON Runtime边界" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding CurrentFeature.Title}" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding CurrentFeature.Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="0,0,8,0" Padding="10,6" Background="#3B1F08" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6">
                        <StackPanel><TextBlock FontWeight="Bold" Foreground="#FBBF24" Text="工程离线" /><TextBlock FontFamily="Consolas" Foreground="#FDE68A" Text="禁止运动" /></StackPanel>
                    </Border>
                    <Border Padding="10,6" Background="#10243B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel><TextBlock Foreground="#93C5FD" Text="{Binding ActiveRecipe}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding CurrentUser}" /></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Margin="8,6,8,10" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Text="开发阶段与运行域" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Features}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,2" Padding="12,10" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectFeatureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="27" Height="27" Margin="0,0,9,0" Background="#123047" CornerRadius="5">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#67E8F9" Text="◆" />
                                            </Border>
                                            <TextBlock Width="150" VerticalAlignment="Center" Text="{Binding NavigationTitle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="#301515" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Foreground="#FCA5A5" Text="安全边界" />
                            <TextBlock Margin="0,4,0,0" Foreground="#FECACA" Text="{Binding MotionPermission}" />
                            <TextBlock Margin="0,3,0,0" Foreground="#FECACA" Text="未接相机 / PLC / 光源" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="10,7" Background="#0B2630" BorderBrush="#155E75" BorderThickness="1" CornerRadius="6">
                    <Grid><TextBlock Foreground="#A5F3FC" Text="{Binding CurrentFeature.StageStatus, StringFormat=阶段状态：{0}}" /><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" Text="所有数值为教学演示，真实设备接入前不允许发布" /></Grid>
                </Border>
                <ContentControl Grid.Row="1" Margin="0,10,0,0" Content="{Binding CurrentFeature}" />
            </Grid>

            <controls:LearningInspector Grid.Column="2" Margin="0,12,12,12" DataContext="{Binding CurrentFeature}" />
        </Grid>

        <Border Grid.Row="2" Background="#351313" BorderBrush="#7F1D1D" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FCA5A5" Text="STOP · MOTION_DISABLED_OFFLINE · PLC/运动未接入，任何补偿仅供显示" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FDE68A" Text="报警：2阻断 / 1提示 · Runtime边界仍需接线" />
            </Grid>
        </Border>
    </Grid>
</Window>
