<UserControl x:Class="VisionSystem.Engineering.Wpf.Controls.LearningInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300">
    <Border Style="{StaticResource PanelBorder}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="本阶段工程说明" />
                <Border Margin="0,10,0,12" Padding="10" Background="#0A2631" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#5EEAD4" Text="为什么要做" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Why}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock FontWeight="SemiBold" Text="输入" />
                <ItemsControl Margin="0,5,0,10" ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Margin="2" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontWeight="SemiBold" Text="输出" />
                <ItemsControl Margin="0,5,0,10" ItemsSource="{Binding Outputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Margin="2" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock FontWeight="SemiBold" Text="HALCON算子链" />
                <ItemsControl Margin="0,6,0,10" ItemsSource="{Binding Operators}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="7,4" Background="#081421" CornerRadius="4">
                                <TextBlock FontFamily="Consolas" Foreground="#7DD3FC" Text="{Binding}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock FontWeight="SemiBold" Text="参数：单位、含义与影响" />
                <ItemsControl Margin="0,6,0,10" ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name}" /><Run Foreground="#FBBF24" Text="{Binding Unit, StringFormat=  [{0}]}" /></TextBlock>
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Meaning}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0" Foreground="#A7F3D0"><Run Text="示例：" /><Run Text="{Binding Example}" /></TextBlock>
                                    <TextBlock Margin="0,2,0,0" Foreground="#FCA5A5" Text="{Binding Effect}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock FontWeight="SemiBold" Text="应检查的中间结果" />
                <ItemsControl Margin="0,5,0,10" ItemsSource="{Binding IntermediateResults}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="2" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontWeight="SemiBold" Text="明确失败码" />
                <ItemsControl Margin="0,5,0,10" ItemsSource="{Binding FailureCodes}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="2" FontFamily="Consolas" Foreground="#FCA5A5" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontWeight="SemiBold" Text="本阶段验收门槛" />
                <ItemsControl Margin="0,5,0,6" ItemsSource="{Binding AcceptanceCriteria}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="2" Foreground="#A7F3D0" Text="{Binding StringFormat=✓ {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
