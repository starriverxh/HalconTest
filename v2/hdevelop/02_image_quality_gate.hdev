<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="23.11.0.0">
<procedure name="main">
<interface/>
<body>
<c>* 02 - Image quality is evaluated in the product ROI, before target localization.</c>
<l>gen_image_const (ImageBase, 'byte', 1000, 600)</l>
<l>gen_rectangle1 (BoardRegion, 35, 35, 565, 965)</l>
<l>paint_region (BoardRegion, ImageBase, Image1, 125, 'fill')</l>
<l>gen_circle (Holes, [300,300,300,300,300], [190,345,500,655,810], [18,18,18,18,18])</l>
<l>paint_region (Holes, Image1, Image, 15, 'fill')</l>
<l>gen_rectangle1 (QualityRoi, 230, 120, 370, 880)</l>
<l>reduce_domain (Image, QualityRoi, QualityImage)</l>
<l>get_domain (QualityImage, QualityDomain)</l>
<l>intensity (QualityDomain, QualityImage, MeanGray, GrayDeviation)</l>
<l>sobel_amp (QualityImage, EdgeAmplitude, 'sum_abs', 3)</l>
<l>intensity (QualityDomain, EdgeAmplitude, MeanEdgeAmplitude, EdgeDeviation)</l>
<l>threshold (QualityImage, SaturatedRegion, 250, 255)</l>
<l>area_center (QualityDomain, DomainArea, DomainRow, DomainColumn)</l>
<l>area_center (SaturatedRegion, SaturatedAreaTuple, SaturatedRow, SaturatedColumn)</l>
<l>if (|SaturatedAreaTuple| == 0)</l>
<l>    SaturatedArea := 0</l>
<l>else</l>
<l>    SaturatedArea := sum(SaturatedAreaTuple)</l>
<l>endif</l>
<l>SaturatedFraction := SaturatedArea / DomainArea</l>
<l>MeanGrayOk := MeanGray &gt;= 20 and MeanGray &lt;= 240</l>
<l>ContrastOk := GrayDeviation &gt;= 5</l>
<l>FocusProxyOk := MeanEdgeAmplitude &gt;= 1</l>
<l>SaturationOk := SaturatedFraction &lt;= 0.25</l>
<l>ImageQualityPassed := MeanGrayOk and ContrastOk and FocusProxyOk and SaturationOk</l>
</body>
</procedure>
</hdevelop>
