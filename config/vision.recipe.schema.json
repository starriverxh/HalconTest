{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HALCON C# pin insertion vision recipe",
  "type": "object",
  "required": ["recipeName", "recipeVersion", "camera", "holeDetection", "imageQuality", "localization", "calibration", "toolReferencePose", "tolerances"],
  "properties": {
    "recipeName": { "type": "string", "minLength": 1 },
    "recipeVersion": { "type": "integer", "minimum": 1 },
    "updatedUtc": { "type": "string", "format": "date-time" },
    "camera": {
      "type": "object",
      "required": ["mode", "imagePath"],
      "properties": {
        "mode": { "enum": ["File"] },
        "imagePath": { "type": "string", "minLength": 1 },
        "interfaceName": { "type": "string" },
        "device": { "type": "string" },
        "exposureMicroseconds": { "type": "number", "exclusiveMinimum": 0 },
        "gainDb": { "type": "number" },
        "acquisitionTimeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "holeDetection": {
      "type": "object",
      "required": ["thresholdMin", "thresholdMax", "minRadiusPx", "maxRadiusPx", "minCircularity", "expectedCount"],
      "properties": {
        "searchRoi": {
          "type": ["object", "null"],
          "required": ["row1", "column1", "row2", "column2"]
        }
      }
    },
    "localization": {
      "type": "object",
      "required": ["mode", "modelFile", "angleStartDeg", "angleExtentDeg", "minScore"],
      "properties": {
        "mode": { "enum": ["BlobRow", "ShapeModel"] },
        "modelFile": { "type": "string" },
        "minScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "imageQuality": {
      "type": "object",
      "required": ["minimumMeanGray", "maximumMeanGray", "minimumGrayDeviation", "minimumMeanEdgeAmplitude", "saturationGray", "maximumSaturatedFraction"]
    },
    "calibration": {
      "type": "object",
      "required": ["pointsFile", "modelFile"]
    },
    "toolReferencePose": {
      "type": "object",
      "required": ["xmm", "ymm", "thetaDeg"]
    },
    "tolerances": {
      "type": "object",
      "required": ["maxCorrectionMm", "maxRotationDeg", "maxCalibrationRmseMm", "maxCalibrationErrorMm", "minimumFeatureScore"]
    }
  }
}
